<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- BUG FIX (premium native launch experience): this used to show
         the default unbranded Capacitor placeholder (drawable/splash.png,
         a white background with a generic blue mark) for a split second
         at every cold launch. android:background is kept as a safe
         fallback for the rare pre-Android-12 legacy path (drawable/splash.png
         is now solid near-black, matching windowSplashScreenBackground below;
         see @capacitor/splash-screen's SplashScreen.java, which only
         falls back to it if the modern API throws). The
         windowSplashScreen* attributes below are what androidx.core:core
         splashscreen (already a dependency, see app/build.gradle) and
         @capacitor/splash-screen actually use on real devices: a solid
         ZERINIX black background plus the existing "ZX" mark centered on
         screen, matching the same badge used throughout the app's own UI
         (see components/MobileNavigation.tsx). No wordmark text here;
         windowSplashScreenAnimatedIcon is a fixed-size icon slot, not a
         full lockup, and this androidx-compat version has no
         windowSplashScreenBrandingImage attribute to place one elsewhere. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#050706</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>